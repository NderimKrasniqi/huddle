{
  "expo": {
    "name": "Huddle",
    "slug": "huddle-phone",
    "scheme": "huddle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "android": {
      "package": "tv.huddle.phone",
      "icon": "../../packages/ui/assets/app-icons/huddle-android-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "../../packages/ui/assets/app-icons/huddle-android-adaptive-foreground.png",
        "monochromeImage": "../../packages/ui/assets/app-icons/huddle-android-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "tv.huddle.phone",
      "supportsTablet": false,
      "icon": {
        "light": "../../packages/ui/assets/app-icons/huddle-app-icon-light.png",
        "dark": "../../packages/ui/assets/app-icons/huddle-app-icon-dark.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Huddle to scan a room QR code",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "../../packages/ui/assets/app-icons/huddle-splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": { "bundler": "metro" },
    "icon": "../../packages/ui/assets/app-icons/huddle-app-icon-light.png"
  }
}
