    "prebuild": "LC_ALL=en_US.UTF-8 expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:render": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@huddle/convex": "workspace:*",
