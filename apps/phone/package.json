{
  "name": "@huddle/phone",
  "version": "0.1.0",
  "private": true,
  "description": "Huddle Phone app.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android --port 8082",
