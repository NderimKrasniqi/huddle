{
  "expo": {
    "name": "Huddle",
    "slug": "huddle-tv",
    "scheme": "huddle",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9F1E6",
    "newArchEnabled": true,
    "android": {
      "package": "tv.huddle.hub",
      "icon": "../../packages/ui/assets/app-icons/huddle-android-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "../../packages/ui/assets/app-icons/huddle-android-adaptive-foreground.png",
        "monochromeImage": "../../packages/ui/assets/app-icons/huddle-android-monochrome.png",
        "backgroundColor": "#F9F1E6"
      }
    },
    "ios": {
      "bundleIdentifier": "tv.huddle.hub",
      "icon": {
        "light": "../../packages/ui/assets/app-icons/huddle-app-icon-light.png",
        "dark": "../../packages/ui/assets/app-icons/huddle-app-icon-dark.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../../packages/ui/assets/app-icons/huddle-splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F9F1E6"
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVIcon": "../../packages/ui/assets/app-icons/huddle-android-tv-icon.png",
          "androidTVBanner": "../../packages/ui/assets/app-icons/huddle-android-tv-banner.png",
          "appleTVImages": {
            "icon": "../../packages/ui/assets/app-icons/apple-tv/huddle-tv-icon-1280x768.png",
            "iconSmall": "../../packages/ui/assets/app-icons/apple-tv/huddle-tv-icon-400x240.png",
            "iconSmall2x": "../../packages/ui/assets/app-icons/apple-tv/huddle-tv-icon-800x480.png",
            "topShelf": "../../packages/ui/assets/app-icons/apple-tv/huddle-tv-top-shelf-1920x720.png",
            "topShelf2x": "../../packages/ui/assets/app-icons/apple-tv/huddle-tv-top-shelf-3840x1440.png",
            "topShelfWide": "../../packages/ui/assets/app-icons/apple-tv/huddle-tv-top-shelf-wide-2320x720.png",
            "topShelfWide2x": "../../packages/ui/assets/app-icons/apple-tv/huddle-tv-top-shelf-wide-4640x1440.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": { "bundler": "metro" },
    "icon": "../../packages/ui/assets/app-icons/huddle-app-icon-light.png"
  }
}
