# The Convex deployment this app talks to. Committed on purpose: a Convex
# deployment URL is public (every client ships it in its bundle) and a fresh
# clone has to be able to run the TV app without first being handed a secret.
#
# This is the huddle project's cloud dev deployment, so it is reachable from a
# real Philips TV and a real phone, not only from a simulator on the machine
# that started a backend. To develop against a local backend instead, run
# `pnpm --filter @huddle/convex dev` and put its 127.0.0.1 URL in
# `apps/tv/.env.local`, which is gitignored and wins over this file.
EXPO_PUBLIC_CONVEX_URL=https://colorful-viper-224.convex.cloud
