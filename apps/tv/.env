# The Convex deployment this app talks to. Committed on purpose: a Convex
# deployment URL is public (every client ships it) and a fresh clone has to be
# able to run the TV app without first being handed a secret.
#
# The value below is the anonymous local backend `pnpm --filter @huddle/convex
# dev` starts — reachable from a simulator on this machine, and from nothing
# else. Point a device build somewhere reachable by putting your own value in
# `apps/tv/.env.local` (gitignored, wins over this file); the Convex cloud
# deployment that replaces it for real hardware is a Phase 5 task.
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
