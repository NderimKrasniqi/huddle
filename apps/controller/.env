# The Convex deployment this app talks to. Committed on purpose: a Convex
# deployment URL is public (every client ships it in its bundle) and a fresh
# clone has to be able to run the Controller without first being handed a
# secret.
#
# The same huddle cloud dev deployment the TV app points at (apps/tv/.env) —
# they have to be the same one, or a phone joins a room no television is
# showing. To develop against a local backend instead, run
# `pnpm --filter @huddle/convex dev` and put its 127.0.0.1 URL in
# `apps/controller/.env.local`, which is gitignored and wins over this file.
EXPO_PUBLIC_CONVEX_URL=https://colorful-viper-224.convex.cloud
