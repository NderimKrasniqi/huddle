{
  "expo": {
    "name": "Huddle",
    "slug": "huddle-controller",
    "scheme": "huddle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "tv.huddle.controller"
    },
    "ios": {
      "bundleIdentifier": "tv.huddle.controller",
      "supportsTablet": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
