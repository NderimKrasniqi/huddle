{
  "name": "@huddle/convex",
  "version": "0.1.0",
  "private": true,
  "description": "Convex backend: the authoritative room state, mutations, and scheduled functions.",
  "//": "The apps import the generated `api` object from here so that function references stay typed end-to-end; nothing else in this package is public.",
  "exports": {
    ".": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "typecheck": "tsc --noEmit --project convex"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "@huddle/game-core": "workspace:*",
    "@huddle/game-registry": "workspace:*",
    "convex": "^1.42.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.54",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
