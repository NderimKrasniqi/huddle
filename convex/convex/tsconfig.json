{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  // `_generated` is committed (Convex's convention) and typechecked with the
  // rest, so codegen drift shows up as a type error.
  "include": ["./**/*"]
}
