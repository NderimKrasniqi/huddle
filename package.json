{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "audit:prod": "pnpm audit --prod --ignore CVE-2025-71329 --ignore CVE-2025-71330",
    "verify:dependency-security": "node tools/verify-dependency-security.cjs",
    "test": "vitest run && pnpm test:render",
    "test:render": "pnpm --filter @huddle/phone test:render && pnpm --filter @huddle/tv test:render",
    "test:unit": "vitest run --project packages --project apps",
    "test:integration": "vitest run --project convex",
    "validate:packs": "node --import tsx games/trivia/future/content/validate-packs.ts",
    "verify:bundle-seam": "node tools/verify-client-bundle.cjs",
    "validate:workflow": "python3 tools/validate-workflow.py",
    "validate:architecture": "python3 tools/validate-architecture.py",
    "validate:game-contracts": "vitest run --project packages games/*/src/*.test.ts packages/game-registry/src/*.test.ts",
    "validate:routes": "python3 tools/validate-architecture.py",
    "validate:native-identity": "python3 tools/validate-architecture.py",
    "validate:boundaries": "python3 tools/validate-architecture.py",
    "validate:ui-stack": "python3 tools/validate-architecture.py",
    "validate:rate-limits": "vitest run --project convex convex/convex/lib/rateLimits.test.ts convex/convex/rooms.test.ts",
    "validate:guest-profile": "vitest run --project apps apps/phone/src/features/join/identity.test.ts && vitest run --project convex convex/convex/players.test.ts"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "catalog:",
    "@huddle/contracts": "workspace:*",
    "@huddle/domain": "workspace:*",
    "@huddle/game-registry": "workspace:*",
    "@huddle/game-trivia": "workspace:*",
    "@huddle/game-voting": "workspace:*",
    "@huddle/ui": "workspace:*",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
