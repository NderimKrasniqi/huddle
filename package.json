{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "audit:prod": "pnpm audit --prod --ignore CVE-2025-71329 --ignore CVE-2025-71330",
    "verify:dependency-security": "node tools/verify-dependency-security.cjs",
    "test": "vitest run && pnpm test:render",
    "test:render": "pnpm --filter @huddle/controller test:render && pnpm --filter @huddle/tv test:render",
    "test:unit": "vitest run --project lint-rules --project packages --project apps",
    "test:integration": "vitest run --project convex",
    "validate:packs": "node --import tsx packages/packs/src/validate-packs.ts",
    "validate:workflow": "python3 tools/validate-workflow.py"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@huddle/game-core": "workspace:*",
    "@huddle/game-registry": "workspace:*",
    "@huddle/game-trivia": "workspace:*",
    "@huddle/game-voting": "workspace:*",
    "@huddle/packs": "workspace:*",
    "@huddle/ui": "workspace:*",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
