{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "audit:prod": "pnpm audit --prod --ignore CVE-2025-71329 --ignore CVE-2025-71330",
    "verify:dependency-security": "node tools/verify-dependency-security.cjs",
    "validate:packs": "node --import tsx games/trivia/src/content/validate-packs.ts",
    "verify:bundle-seam": "node tools/verify-client-bundle.cjs",
    "sim:status": "node tools/run-simulators.mjs status",
    "sim:phone": "node tools/run-simulators.mjs phone",
    "sim:tv": "node tools/run-simulators.mjs tv",
    "sim:tvos": "node tools/run-simulators.mjs tvos",
    "sim:all": "node tools/run-simulators.mjs all",
    "validate:workflow": "python3 tools/validate-workflow.py",
    "validate:architecture": "python3 tools/validate-architecture.py",
    "validate:routes": "python3 tools/validate-architecture.py",
    "validate:native-identity": "python3 tools/validate-architecture.py",
    "validate:boundaries": "python3 tools/validate-architecture.py",
    "validate:ui-stack": "python3 tools/validate-architecture.py",
    "dev:local": "tools/dev-local.sh",
    "tv:emulator": "tools/tv-emulator.sh",
    "e2e:bomb-squad": "tools/e2e-bomb-squad.sh",
    "e2e:phone-starts": "tools/e2e-flow.sh e2e/phone-starts.yaml"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@huddle/contracts": "workspace:*",
    "@huddle/domain": "workspace:*",
    "@huddle/game-registry": "workspace:*",
    "@huddle/game-trivia": "workspace:*",
    "@huddle/ui": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
