--- a/packages/game-registry/src/registry.ts
+++ b/packages/game-registry/src/registry.ts
@@ -14,4 +14,18 @@ import { triviaGameModule } from '@huddle/game-trivia';
  * a hub that reads a registry of one and a hub that reads a registry of six are
