{
  "meta": {
    "name": "Huddle Soft Minimal — Expo Phone + TV",
    "version": "1.1",
    "notes": "Core brand colors are approved. Phone/TV scales and semantic status colors are implementation baselines derived from the approved Soft Minimal UI reference."
  },
  "color": {
    "brand": {
      "orange": "#FF6B4A",
      "softPeach": "#FFE9DE",
      "warmOffWhite": "#FFF7F2",
      "deepNavy": "#0F172A",
      "sage": "#A7B3A6",
      "warmGrey": "#E9E6E2"
    },
    "surface": {
      "canvas": "#FFF7F2",
      "card": "#FFFFFF",
      "soft": "#FFE9DE",
      "border": "#E9E6E2"
    },
    "status": {
      "online": "#34A853",
      "justJoined": "#2D9CDB",
      "away": "#A0A4AA",
      "host": "#FF6B4A"
    }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 40, 48, 64, 80],
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "card": 24,
    "pill": 999
  },
  "phone": {
    "layout": {
      "contentPadding": 24,
      "controlMinHeight": 48,
      "avatarPickerGap": 12,
      "sectionGap": 24
    },
    "typography": {
      "title": { "fontSize": 32, "lineHeight": 40, "fontWeight": 700 },
      "heading": { "fontSize": 24, "lineHeight": 32, "fontWeight": 700 },
      "body": { "fontSize": 16, "lineHeight": 24, "fontWeight": 400 },
      "label": { "fontSize": 13, "lineHeight": 18, "fontWeight": 600 },
      "caption": { "fontSize": 12, "lineHeight": 16, "fontWeight": 400 }
    }
  },
  "tv": {
    "layout": {
      "safeMargin": 64,
      "contentGap": 32,
      "playerGap": 20,
      "carouselGap": 28
    },
    "focus": {
      "borderColor": "#FF6B4A",
      "borderWidth": 3,
      "scale": 1.04
    },
    "typography": {
      "display": { "fontSize": 56, "lineHeight": 64, "fontWeight": 700 },
      "heading": { "fontSize": 40, "lineHeight": 48, "fontWeight": 700 },
      "body": { "fontSize": 22, "lineHeight": 30, "fontWeight": 400 },
      "label": { "fontSize": 18, "lineHeight": 24, "fontWeight": 600 },
      "caption": { "fontSize": 16, "lineHeight": 22, "fontWeight": 400 }
    }
  }
}
